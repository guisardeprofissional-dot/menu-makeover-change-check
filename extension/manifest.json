{
  "manifest_version": 3,
  "name": "Absolluto Pizzaria - Painel de Pedidos",
  "version": "2.9.2",
  "description": "Absolluto Pizzaria: atendente com IA no WhatsApp, pedidos, impressão e cardápio. Sabor que você sente, qualidade que você confia!",
  "permissions": ["storage", "tabs", "debugger"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://*.lovable.app/*", "https://*/*"],
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*"], "js": ["pdf-direct.js", "vendor/wppconnect-wa.js", "page-hooks.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://web.whatsapp.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["sidepanel.html", "sidepanel.js", "sidepanel.css", "bot.js", "order-details.js", "cardapio.pdf", "logo.png", "icons/*"], "matches": ["https://web.whatsapp.com/*"] }
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Absolluto Pizzaria",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
